# Firebase Configuration
FIREBASE_PROJECT_ID=shougaku-kore-doutoku
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=shougaku-kore-doutoku.firebaseapp.com
FIREBASE_STORAGE_BUCKET=shougaku-kore-doutoku.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# Firebase Emulator (Development Only)
USE_FIREBASE_EMULATOR=false
FIREBASE_EMULATOR_HOST=localhost
FIREBASE_AUTH_EMULATOR_PORT=9099
FIRESTORE_EMULATOR_PORT=8080

# API Configuration
API_BASE_URL=https://api.shougaku-kore.jp
API_TIMEOUT_SECONDS=30

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true
ENABLE_AUDIO_NARRATION=true
ENABLE_PARENT_REPORTS=true
ENABLE_DEBUG_MODE=false

# Logging Configuration
LOG_LEVEL=info
ENABLE_STRUCTURED_LOGGING=true
ENABLE_SENTRY_REPORTING=false

# Sentry Configuration (Error Tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACE_SAMPLE_RATE=1.0

# App Configuration
APP_VERSION=0.1.0
APP_BUILD_NUMBER=1
APP_ENVIRONMENT=development

# Localization
DEFAULT_LANGUAGE=ja
SUPPORTED_LANGUAGES=ja,en
